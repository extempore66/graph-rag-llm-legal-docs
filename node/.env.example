ARANGO_URL=http://localhost:8529
ARANGO_DB=your_database_name
ARANGO_USER=your_username
ARANGO_PASSWORD=your_password

# Optional -- defaults to ./data/lancedb (relative to the project root) if unset.
LANCEDB_DIR=./data/lancedb

# Optional -- both default to the values below if unset.
OLLAMA_URL=http://localhost:11434
EXTRACTION_MODEL=qwen3:8b
EMBEDDING_MODEL=bge-large

# Optional -- Steps 4-6 dedup tuning, both default to the values below if unset.
SNIPPET_WINDOW_WORDS=15
JARO_WINKLER_THRESHOLD=0.85
